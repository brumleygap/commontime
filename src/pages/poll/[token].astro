---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import { isPollLocked } from "../../lib/poll";

const { token } = Astro.params;
const db = env.DB;

const voteResult = await Astro.getActionResult(actions.submitVote);
const voteError = voteResult?.error;
const voteSuccess = voteResult?.data?.ok === true;

const lockResult = await Astro.getActionResult(actions.lockPoll);
const lockError = lockResult?.error;

const unlockResult = await Astro.getActionResult(actions.unlockPoll);
const unlockError = unlockResult?.error;

const cancelResult = await Astro.getActionResult(actions.cancelPoll);
const cancelError = cancelResult?.error;

const deleteResult = await Astro.getActionResult(actions.deletePoll);
if (deleteResult?.data?.ok) return Astro.redirect("/");

const inviteResult = await Astro.getActionResult(actions.inviteParticipants);
const inviteError = inviteResult?.error;

const welcomed = Astro.url.searchParams.get("welcomed") === "1";

// ── Data loading ──────────────────────────────────────────────────────────────

const poll = await db
  .prepare(
    `SELECT id, token, title, description, timezone, creator_id, created_at, chosen_option_id, cancelled_at, rescheduled_poll_token, duration_minutes, last_reminded_at
     FROM polls WHERE token = ?`
  )
  .bind(token)
  .first<{
    id: number;
    token: string;
    title: string;
    description: string | null;
    timezone: string;
    creator_id: number | null;
    created_at: string;
    chosen_option_id: number | null;
    cancelled_at: string | null;
    rescheduled_poll_token: string | null;
    duration_minutes: number;
    last_reminded_at: string | null;
  }>();

if (!poll) return new Response("Poll not found", { status: 404 });

// Track this poll in the browser so the home page can surface it,
// even if the visitor has never voted (e.g. they were invited and haven't responded yet).
const prevTokens = (Astro.cookies.get("recent_polls")?.value ?? "").split(",").filter(Boolean);
if (!prevTokens.includes(poll.token)) prevTokens.unshift(poll.token);
Astro.cookies.set("recent_polls", prevTokens.slice(0, 10).join(","), {
  path: "/",
  maxAge: 60 * 60 * 24 * 90,
  sameSite: "lax",
  secure: true,
  httpOnly: true,
});

const options = (
  await db
    .prepare(
      `SELECT id, option_datetime FROM poll_options WHERE poll_id = ? ORDER BY option_datetime ASC`
    )
    .bind(poll.id)
    .all<{ id: number; option_datetime: string }>()
).results;

const participants = (
  await db
    .prepare(
      `SELECT id, name FROM participants WHERE poll_id = ? ORDER BY created_at ASC`
    )
    .bind(poll.id)
    .all<{ id: number; name: string | null }>()
).results;

const allVotes = (
  await db
    .prepare(
      `SELECT v.participant_id, v.option_id, v.availability
       FROM votes v
       JOIN participants p ON p.id = v.participant_id
       WHERE p.poll_id = ?`
    )
    .bind(poll.id)
    .all<{ participant_id: number; option_id: number; availability: number }>()
).results;

// ── Pre-populate logged-in user's existing votes ──────────────────────────────

const currentUser = Astro.locals.user ?? null;
let myParticipantId: number | null = null;
const myVoteMap = new Map<number, number>(); // optionId → availability

// Invite token from ?invite= query param. Use let — may be nulled out if forwarded.
let inviteToken = Astro.url.searchParams.get("invite") ?? null;
let inviteEmail: string | null = null;
let inviteName: string | null = null;

if (currentUser) {
  const myParticipant = await db
    .prepare(`SELECT id FROM participants WHERE poll_id = ? AND user_id = ?`)
    .bind(poll.id, currentUser.id)
    .first<{ id: number }>();

  if (myParticipant) {
    myParticipantId = myParticipant.id;
    const myVotes = (
      await db
        .prepare(`SELECT option_id, availability FROM votes WHERE participant_id = ?`)
        .bind(myParticipant.id)
        .all<{ option_id: number; availability: number }>()
    ).results;
    for (const v of myVotes) myVoteMap.set(v.option_id, v.availability);
  }
} else if (inviteToken) {
  const inviteParticipant = await db
    .prepare(`SELECT id, name, email, claimed_at FROM participants WHERE edit_token = ? AND poll_id = ?`)
    .bind(inviteToken, poll.id)
    .first<{ id: number; name: string | null; email: string | null; claimed_at: string | null }>();

  if (inviteParticipant) {
    const cookieName = `ct_inv_${inviteToken}`;
    const hasCookie = !!Astro.cookies.get(cookieName)?.value;

    if (!inviteParticipant.claimed_at) {
      // First visit — claim the invite and set a cookie so this browser can return
      await db
        .prepare(`UPDATE participants SET claimed_at = datetime('now') WHERE id = ?`)
        .bind(inviteParticipant.id)
        .run();
      Astro.cookies.set(cookieName, "1", {
        path: "/",
        maxAge: 60 * 60 * 24 * 30,
        sameSite: "lax",
        secure: true,
        httpOnly: true,
      });
      myParticipantId = inviteParticipant.id;
      inviteEmail = inviteParticipant.email;
      inviteName = inviteParticipant.name;
    } else if (hasCookie) {
      // Returning invitee — same browser that claimed it
      myParticipantId = inviteParticipant.id;
      inviteEmail = inviteParticipant.email;
      inviteName = inviteParticipant.name;
      const myVotes = (
        await db
          .prepare(`SELECT option_id, availability FROM votes WHERE participant_id = ?`)
          .bind(inviteParticipant.id)
          .all<{ option_id: number; availability: number }>()
      ).results;
      for (const v of myVotes) myVoteMap.set(v.option_id, v.availability);
    } else {
      // Forwarded link — already claimed by a different browser; treat as anonymous
      inviteToken = null;
    }
  }
}

// ── Poll state ────────────────────────────────────────────────────────────────

const isCreator = !!(currentUser && poll.creator_id && currentUser.id === poll.creator_id);
const isCancelled = poll.cancelled_at !== null;
const isOpen = !isPollLocked(poll) && !isCancelled;

// Non-responder count and reminder cooldown (creator only)
let nonResponderCount = 0;
let reminderCooldownHours: number | null = null;
if (isCreator && isOpen) {
  const nrRow = await db
    .prepare(`
      SELECT COUNT(*) AS n
      FROM participants pa
      LEFT JOIN users u ON u.id = pa.user_id
      WHERE pa.poll_id = ?
        AND COALESCE(u.email, pa.email) IS NOT NULL
        AND NOT EXISTS (SELECT 1 FROM votes v WHERE v.participant_id = pa.id)
    `)
    .bind(poll.id)
    .first<{ n: number }>();
  nonResponderCount = nrRow?.n ?? 0;

  const isAdmin = currentUser?.email === "ernie.braganza@gmail.com";
  if (!isAdmin && poll.last_reminded_at) {
    const hoursElapsed = (Date.now() - new Date(poll.last_reminded_at).getTime()) / (1000 * 60 * 60);
    if (hoursElapsed < 24) {
      reminderCooldownHours = Math.ceil(24 - hoursElapsed);
    }
  }
}

const chosenOptions = poll.chosen_option_id
  ? (await db
      .prepare(`
        SELECT po.id, po.option_datetime
        FROM chosen_poll_options cpo
        JOIN poll_options po ON po.id = cpo.option_id
        WHERE cpo.poll_id = ?
        ORDER BY po.option_datetime ASC
      `)
      .bind(poll.id)
      .all<{ id: number; option_datetime: string }>()
    ).results
  : [];
const chosenOptionIds = new Set(chosenOptions.map(o => o.id));

// ── Build vote map for grid ───────────────────────────────────────────────────

// participantId → optionId → availability (0/1/2) | undefined = no response
const voteMap = new Map<number, Map<number, number>>();
for (const v of allVotes) {
  if (!voteMap.has(v.participant_id)) voteMap.set(v.participant_id, new Map());
  voteMap.get(v.participant_id)!.set(v.option_id, v.availability);
}

// Participants who have submitted at least one vote row
const respondedIds = new Set(allVotes.map((v) => v.participant_id));

// ── Option stats for the grid columns ────────────────────────────────────────

const optionStats = options.map((opt) => {
  let yesCount = 0;
  let maybeCount = 0;
  const yesNames: string[] = [];
  const maybeNames: string[] = [];

  for (const p of participants) {
    const av = voteMap.get(p.id)?.get(opt.id);
    if (av === 1) { yesCount++; yesNames.push(p.name ?? "Anonymous"); }
    else if (av === 2) { maybeCount++; maybeNames.push(p.name ?? "Anonymous"); }
  }

  return { ...opt, yesCount, maybeCount, score: yesCount * 2 + maybeCount, yesNames, maybeNames };
});

const maxScore = Math.max(0, ...optionStats.map((o) => o.score));

// ── Group options by calendar day for the vote form ──────────────────────────

type DayGroup = {
  dayName: string;    // "Monday"
  shortDate: string;  // "Apr 27"
  options: typeof options;
};

const dayGroups: DayGroup[] = [];
const dayKeyIndex = new Map<string, number>();

for (const opt of options) {
  const d = new Date(opt.option_datetime);
  const key = d.toISOString().slice(0, 10);
  if (!dayKeyIndex.has(key)) {
    dayKeyIndex.set(key, dayGroups.length);
    dayGroups.push({
      dayName: d.toLocaleDateString("en-US", { weekday: "long" }),
      shortDate: d.toLocaleDateString("en-US", { month: "short", day: "numeric" }),
      options: [],
    });
  }
  dayGroups[dayKeyIndex.get(key)!].options.push(opt);
}

// ── Helpers ───────────────────────────────────────────────────────────────────

const fmtT = (d: Date) => d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });

function fmtTime(dt: string, durationMins: number) {
  const start = new Date(dt);
  const end = new Date(start.getTime() + durationMins * 60 * 1000);
  return { start: fmtT(start), end: fmtT(end), full: `${fmtT(start)} – ${fmtT(end)}` };
}

function fmtColDate(dt: string, durationMins: number) {
  const start = new Date(dt);
  const end = new Date(start.getTime() + durationMins * 60 * 1000);
  return {
    date: start.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }),
    timeStart: fmtT(start),
    timeFull: `${fmtT(start)} – ${fmtT(end)}`,
  };
}

function fmtFull(dt: string, durationMins: number) {
  const start = new Date(dt);
  const end = new Date(start.getTime() + durationMins * 60 * 1000);
  const fmtT = (d: Date) => d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
  return start.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })
    + " · "
    + `${fmtT(start)} – ${fmtT(end)}`;
}

// Cell background for a given availability value
function cellBg(av: number | undefined): string {
  if (av === 1) return "background:var(--yes-bg)";
  if (av === 2) return "background:var(--maybe-bg)";
  if (av === 0) return "background:var(--busy-bg);opacity:0.6";
  return "";
}

function cellGlyph(av: number | undefined): string {
  if (av === 1) return "✓";
  if (av === 2) return "~";
  if (av === 0) return "✕";
  return "—";
}

function cellColor(av: number | undefined): string {
  if (av === 1) return "var(--yes)";
  if (av === 2) return "var(--maybe)";
  if (av === 0) return "var(--red)";
  return "var(--placeholder)";
}
---

<BaseLayout title={poll.title}>
  <!-- Poll header -->
  <div class="poll-header">
    <div class="mx-auto max-w-5xl px-4 py-6 relative z-10">
      {currentUser && <a href="/" class="poll-back">All Polls</a>}
      <h1 class="poll-title">{poll.title}</h1>
      {poll.description && (
        <p class="poll-desc">{poll.description}</p>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 py-8 space-y-10" style={isCreator && isOpen ? "padding-bottom:100px" : ""}>


    <!-- ── Cancelled banner / finalized banner / vote form ─────────────── -->
    {isCancelled ? (
      <div class="cancelled-banner">
        <div class="cancelled-banner-icon" aria-hidden="true">✕</div>
        <div style="flex:1">
          <p class="cancelled-eyebrow">Poll cancelled</p>
          <p class="cancelled-sub">The organiser has cancelled this meeting. All participants have been notified.</p>
          {poll.rescheduled_poll_token && (
            <p class="cancelled-rescheduled">
              This poll was rescheduled. <a href={`/poll/${poll.rescheduled_poll_token}`} class="cancelled-rescheduled-link">View new poll →</a>
            </p>
          )}
          {isCreator && !poll.rescheduled_poll_token && (
            <div class="reopen-section" style="border-top-color:rgba(200,16,46,0.2)">
              <a href={`/create?from=${token}`} class="try-new-dates-btn-detail">· Try New Dates</a>
            </div>
          )}
        </div>
      </div>
    ) : !isOpen ? (
      <div class="finalized-banner">
        <div class="finalized-banner-icon" aria-hidden="true">★</div>
        <div style="flex:1">
          <p class="finalized-eyebrow">{chosenOptions.length > 1 ? `${chosenOptions.length} dates confirmed` : "Date confirmed"}</p>
          {chosenOptions.map((opt) => (
            <p class="finalized-date">{fmtFull(opt.option_datetime, poll.duration_minutes ?? 60)}</p>
          ))}
          <p class="finalized-sub">This poll is closed. Thanks to everyone who responded.</p>
          <a href={`/poll/${poll.token}/calendar.ics`} class="finalized-cal-link">{chosenOptions.length > 1 ? "Add all to calendar →" : "Add to calendar →"}</a>

          {isCreator && (
            <div class="reopen-section">
              {unlockError && (
                <p class="reopen-error">{unlockError.message}</p>
              )}
              <p class="reopen-warning">Finalization emails have already been sent. Re-opening will notify everyone that voting is back on.</p>
              <form method="POST" action={actions.unlockPoll}>
                <input type="hidden" name="token" value={token} />
                <button type="submit" class="reopen-btn">Re-open for voting</button>
              </form>
              <a href={`/poll/${poll.token}/edit`} class="edit-details-link">Edit title or description →</a>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="vote-card">
        <div class="vote-card-head">
          <h2 class="vote-card-title">Your availability</h2>
          <p class="vote-card-sub">
            {myParticipantId ? "Update your response below." : "Mark each time as yes, if needed, or no."}
          </p>
        </div>

        {voteSuccess && (
          <div class="success-banner auto-banner">
            <div class="banner-body">
              <strong>Response saved!</strong>
              <span>Scroll down to see the updated availability.</span>
            </div>
            <button type="button" class="banner-close" aria-label="Dismiss">×</button>
          </div>
        )}

        {voteError && (
          <div class="error-banner-inline">
            <strong>Couldn't save your response.</strong>
            {voteError.message && <span>{voteError.message}</span>}
          </div>
        )}

        {welcomed && currentUser && (
          <div class="welcomed-banner auto-banner">
            <div class="banner-body">
              <strong>Welcome to CommonTime!</strong>
              <span>You've been invited to this poll. Mark your availability below.</span>
              <a href="/login" class="welcomed-passkey-link">Add a passkey for easy sign-in next time →</a>
            </div>
            <button type="button" class="banner-close" aria-label="Dismiss">×</button>
          </div>
        )}

        {!welcomed && myParticipantId && (
          <div class="welcome-banner auto-banner">
            <div class="banner-body">
              <strong>Welcome back{currentUser?.name ? `, ${currentUser.name}` : currentUser?.email ? `, ${currentUser.email.split("@")[0]}` : ""}!</strong>
              <span>Your previous selections are loaded. Update any time.</span>
            </div>
            <button type="button" class="banner-close" aria-label="Dismiss">×</button>
          </div>
        )}

        <form method="POST" action={actions.submitVote} id="vote-form">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="voteData" id="vote-data" />
          {inviteToken && <input type="hidden" name="invite" value={inviteToken} />}

          <!-- Email row: read-only for invite, required for anonymous, hidden for logged-in -->
          {!currentUser && inviteEmail && (
            <div class="name-row">
              <label class="field-label">Your email</label>
              <p class="invite-email-display">{inviteEmail}</p>
            </div>
          )}
          {!currentUser && !inviteToken && (
            <div class="name-row">
              <label for="voter-email" class="field-label">Your email <span class="required-star">*</span></label>
              <input
                id="voter-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="you@example.com"
                class="name-input"
              />
            </div>
          )}

          <!-- Name row -->
          <div class="name-row">
            <label for="voter-name" class="field-label">Your name</label>
            <input
              id="voter-name"
              name="name"
              type="text"
              autocomplete="name"
              value={currentUser?.name ?? currentUser?.email ?? inviteName ?? ""}
              placeholder="e.g. Priya"
              class="name-input"
            />
          </div>

          <!-- Day groups -->
          {dayGroups.map((group) => (
            <div class="day-group">
              <div class="day-header">
                <span class="day-name">{group.dayName}</span>
                <span class="day-date">{group.shortDate}</span>
              </div>

              {group.options.map((opt) => {
                const existing = myVoteMap.get(opt.id);
                return (
                  <div
                    class="time-row"
                    data-option-id={opt.id}
                    data-init={existing ?? -1}
                  >
                    <div class="time-bullet" data-bullet></div>
                    {(() => { const t = fmtTime(opt.option_datetime, poll.duration_minutes ?? 60); return (
                    <div class="time-label" data-full={t.full}>
                      {t.start}<span class="time-end-suffix"> – {t.end}</span>
                    </div>
                    ); })()}
                    <div class="vibe-pill">
                      <button type="button" class="vibe-seg" data-vibe="1">Yes</button>
                      <button type="button" class="vibe-seg" data-vibe="2">If needed</button>
                      <button type="button" class="vibe-seg" data-vibe="0">No</button>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}

          <div class="vote-submit-row">
            <button type="submit" class="ct-btn">
              {myParticipantId ? "Update my response" : "Save my response"}
            </button>
          </div>
        </form>
      </div>
    )}

    <!-- ── Availability grid ──────────────────────────────────────────────── -->
    <div class="avail-section">
      <h2 class="avail-title">
        <img src="/commontime-logo.svg" alt="" aria-hidden="true" style="width:20px;height:auto;margin-right:8px;vertical-align:middle;opacity:0.85;" />
        Availability
      </h2>

      {participants.length === 0 ? (
        <p class="avail-empty">No responses yet. Be the first!</p>
      ) : (
        <div class="avail-table-outer">
          <div class="avail-table-wrap">
          <table class="avail-table">
            <thead>
              <tr>
                <th class="avail-name-hdr">Who</th>
                {optionStats.map((opt) => {
                  const { date, timeStart, timeFull } = fmtColDate(opt.option_datetime, poll.duration_minutes ?? 60);
                  const isChosen = chosenOptionIds.has(opt.id);
                  const isWinner = isOpen && !isChosen && opt.score === maxScore && opt.score > 0;
                  return (
                    <th
                      class={`avail-opt-hdr${isChosen ? " chosen" : isWinner ? " winner" : ""}`}
                      title={[...opt.yesNames.map(n => `✓ ${n}`), ...opt.maybeNames.map(n => `~ ${n}`)].join("\n") || "No responses yet"}
                      data-full={`${date} · ${timeFull}`}
                    >
                      <span class="avail-hdr-date">{date}</span>
                      <span class="avail-hdr-time" data-full={timeFull}>
                        {timeStart}<span class="time-end-suffix"> – {timeFull.split(" – ")[1]}</span>
                      </span>
                      <span class={`avail-hdr-count${isChosen ? " confirmed" : isWinner ? " hot" : ""}`}>
                        {opt.yesCount}/{respondedIds.size}
                        {isChosen ? " ★" : ""}
                      </span>
                    </th>
                  );
                })}
              </tr>
            </thead>
            <tbody>
              {participants.map((p) => {
                const hasResponded = respondedIds.has(p.id);
                return (
                  <tr class={hasResponded ? "" : "pending-row"}>
                    <td class="avail-name-cell">
                      {p.name ?? <em class="anon">Anonymous</em>}
                      {!hasResponded && <span class="pending-badge">pending</span>}
                    </td>
                    {options.map((opt) => {
                      const av = voteMap.get(p.id)?.get(opt.id);
                      return (
                        <td class="avail-cell" style={cellBg(av)}>
                          <span style={`color:${cellColor(av)};font-weight:${av === 1 ? 700 : 400};font-size:${av === undefined ? "14px" : "17px"};`}>
                            {cellGlyph(av)}
                          </span>
                        </td>
                      );
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
          </div>
          <button class="scroll-hint" aria-label="Scroll right">»</button>
        </div>
      )}

      <!-- Grid legend -->
      {participants.length > 0 && (
        <div class="grid-legend">
          <span><strong style="color:var(--yes)">✓</strong> Yes</span>
          <span><strong style="color:var(--maybe)">~</strong> If needed</span>
          <span><strong style="color:var(--red)">✕</strong> No</span>
          <span style="opacity:.55"><strong>—</strong> No response</span>
        </div>
      )}
    </div>

  </div>

  <!-- ── Organizer bottom bar + drawers (creator only, while open) ─────────── -->
{isCreator && isOpen && (
  <>
    <!-- Overlay -->
    <div class="org-overlay" id="org-overlay"></div>

    <!-- Invite drawer -->
    <div class="org-drawer" id="drawer-invite">
      <div class="org-drawer-header">
        <span class="org-drawer-title">Invite people</span>
        <button class="org-drawer-close" aria-label="Close">×</button>
      </div>
      <div class="org-drawer-body">
        <p class="org-drawer-sub">One entry per line. Include a name or just the email address.</p>
        <form id="bulk-invite-form" data-poll-token={token}>
          <div class="invite-field">
            <div class="invite-label-row">
              <label for="bulk-emails" class="field-label">People to invite</label>
              <div class="invite-info-wrap">
                <button type="button" class="invite-info-btn" aria-label="Format help" id="invite-info-btn"><em>i</em></button>
                <div class="invite-info-popup" id="invite-info-popup" hidden>
                  <p class="invite-info-heading">Accepted formats</p>
                  <ul class="invite-info-list">
                    <li><code>Alice Smith &lt;alice@example.com&gt;</code></li>
                    <li><code>alice@example.com</code></li>
                  </ul>
                  <p class="invite-info-note">One entry per line. Comma-separated emails also work. Names are optional — if omitted they're derived from the email address.</p>
                </div>
              </div>
            </div>
            <textarea
              id="bulk-emails"
              name="emails"
              class="bulk-emails-input"
              rows="6"
              placeholder="Alice Smith <alice@example.com>&#10;Bob Jones <bob@org.com>&#10;carol@company.com"
              autocomplete="off"
              spellcheck="false"
            ></textarea>
          </div>
          <div id="bulk-invite-result" class="bulk-invite-result" style="display:none"></div>
          <div id="bulk-invite-error" class="error-banner-inline" style="display:none">
            <strong>Couldn't send invites.</strong>
            <span id="bulk-invite-error-msg"></span>
          </div>
          <div class="invite-submit-row">
            <button type="submit" class="invite-btn" id="bulk-invite-btn">Send invites</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Confirm drawer -->
    <div class="org-drawer" id="drawer-confirm">
      <div class="org-drawer-header">
        <span class="org-drawer-title">Confirm Dates</span>
        <button class="org-drawer-close" aria-label="Close">×</button>
      </div>
      <div class="org-drawer-body">
        <p class="org-drawer-sub">Choose one or more dates to confirm and close this poll.</p>
        {lockError && (
          <div class="error-banner-inline">
            <strong>Couldn't confirm date.</strong>
            {lockError.message && <span>{lockError.message}</span>}
          </div>
        )}
        <form method="POST" action={actions.lockPoll} class="finalize-form">
          <input type="hidden" name="token" value={token} />
          <div class="finalize-options">
            {optionStats.map((opt) => {
              const isTop = opt.score === maxScore && opt.score > 0;
              return (
                <label class={`finalize-option${isTop ? " top" : ""}`}>
                  <input type="checkbox" name="optionIds" value={opt.id} />
                  <span class="finalize-option-inner">
                    <span class="finalize-option-date">{fmtFull(opt.option_datetime, poll.duration_minutes ?? 60)}</span>
                    <span class="finalize-option-votes">
                      <span style="color:var(--yes)">{opt.yesCount} yes</span>
                      {opt.maybeCount > 0 && <span style="color:var(--maybe)">{opt.maybeCount} maybe</span>}
                      {isTop && <span class="finalize-top-badge">★ top pick</span>}
                    </span>
                  </span>
                </label>
              );
            })}
          </div>
          <div class="finalize-submit-row">
            <div class="finalize-submit-actions">
              <a href={`/create?from=${token}`} class="try-new-dates-link">· Try New Dates</a>
              <div class="finalize-confirm-group">
                {respondedIds.size === 0 && (
                  <p class="finalize-waiting">Waiting for responses before confirming.</p>
                )}
                <button type="submit" class="ct-btn" id="finalize-submit-btn" disabled={respondedIds.size === 0}>
                  ★ Confirm Dates
                </button>
                <p class="finalize-notify-note">This will notify all participants.</p>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Remind drawer -->
    <div class="org-drawer" id="drawer-remind">
      <div class="org-drawer-header">
        <span class="org-drawer-title">Remind non-responders</span>
        <button class="org-drawer-close" aria-label="Close">×</button>
      </div>
      <div class="org-drawer-body">
        <div id="remind-result" class="remind-success" style="display:none"></div>
        <div id="remind-error" class="error-banner-inline" style="display:none">
          <strong>Couldn't send reminders.</strong>
          <span id="remind-error-msg"></span>
        </div>
        {nonResponderCount === 0 ? (
          <p class="org-drawer-sub">Everyone has responded — no one to remind.</p>
        ) : (
          <>
            <p class="org-drawer-sub">
              {nonResponderCount} {nonResponderCount === 1 ? "person hasn't" : "people haven't"} responded yet.
              They'll receive an email with a direct link to this poll.
            </p>
            {reminderCooldownHours !== null ? (
              <p class="remind-cooldown">
                Reminders were sent recently. You can send again in {reminderCooldownHours} hour{reminderCooldownHours !== 1 ? "s" : ""}.
              </p>
            ) : (
              <button type="button" class="invite-btn" id="remind-send-btn" data-poll-token={token}>
                Send reminders
              </button>
            )}
          </>
        )}
      </div>
    </div>

    <!-- Cancel drawer -->
    <div class="org-drawer" id="drawer-cancel">
      <div class="org-drawer-header">
        <span class="org-drawer-title">Cancel poll</span>
        <button class="org-drawer-close" aria-label="Close">×</button>
      </div>
      <div class="org-drawer-body">
        {cancelError && <p class="cancel-error">{cancelError.message}</p>}
        <p class="cancel-warning">Cancelling will notify all participants that the meeting is off. You can still try new dates after cancelling.</p>
        <form method="POST" action={actions.cancelPoll}>
          <input type="hidden" name="token" value={token} />
          <button type="submit" class="cancel-btn" onclick="return confirm('Cancel this poll and notify all participants?\n\nYou can still try new dates after cancelling.')">
            Cancel this poll
          </button>
        </form>
        {participants.length === 0 && (
          <form method="POST" action={actions.deletePoll} style="margin-top:12px;">
            <input type="hidden" name="token" value={token} />
            <button type="submit" class="delete-btn" onclick="return confirm('Permanently delete this poll? This cannot be undone.')">
              Delete poll
            </button>
          </form>
        )}
      </div>
    </div>

    <!-- Fixed bottom bar -->
    <div class="org-bar">
      <button class="org-bar-btn" data-drawer="invite">Invite</button>
      <div class="org-bar-more-wrap">
        <button class="org-bar-btn" id="org-bar-more" aria-haspopup="true" aria-expanded="false">···</button>
        <div class="org-more-menu" id="org-more-menu" hidden>
          <button class="org-more-item" data-drawer="remind">
            Remind{nonResponderCount > 0 ? ` (${nonResponderCount})` : ""}
          </button>
          <a href={`/poll/${poll.token}/edit`} class="org-more-item">Edit poll</a>
          <a href={`/poll/${token}/manage`} class="org-more-item">Links</a>
          <div class="org-more-divider"></div>
          <button class="org-more-item org-more-item--danger" data-drawer="cancel">Cancel poll</button>
        </div>
      </div>
      <button class="org-bar-btn org-bar-btn--primary" data-drawer="confirm">★ Confirm</button>
    </div>
  </>
)}

<!-- Time detail popup (mobile only) -->
<div id="time-popup" class="time-popup" hidden>
  <p id="time-popup-text" class="time-popup-text"></p>
  <button id="time-popup-close" class="time-popup-close">Done</button>
</div>
<div id="time-popup-overlay" class="time-popup-overlay" hidden></div>
</BaseLayout>

