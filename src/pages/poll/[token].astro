</style>

<script>
  import { actions } from "astro:actions";

  // ── Organizer bottom drawer ──────────────────────────────────────────────
  const overlay = document.getElementById("org-overlay");

  function openDrawer(id: string) {
    closeAllDrawers();
    document.getElementById(`drawer-${id}`)?.classList.add("open");
    overlay?.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeAllDrawers() {
    document.querySelectorAll(".org-drawer.open").forEach(d => d.classList.remove("open"));
    overlay?.classList.remove("open");
    document.body.style.overflow = "";
  }

  // Bar buttons open drawers
  document.querySelectorAll<HTMLButtonElement>(".org-bar-btn[data-drawer]").forEach(btn => {
    btn.addEventListener("click", () => openDrawer(btn.dataset.drawer!));
  });

  // Close buttons and overlay close all drawers
  document.querySelectorAll(".org-drawer-close").forEach(btn => {
    btn.addEventListener("click", closeAllDrawers);
  });
  overlay?.addEventListener("click", closeAllDrawers);

  // ── More popup menu ──────────────────────────────────────────────────────
  const moreBtn = document.getElementById("org-bar-more") as HTMLButtonElement | null;
  const moreMenu = document.getElementById("org-more-menu") as HTMLElement | null;

  function closeMoreMenu() {
    if (!moreMenu || !moreBtn) return;
    moreMenu.hidden = true;
    moreBtn.setAttribute("aria-expanded", "false");
  }

  if (moreBtn && moreMenu) {
    moreBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const opening = moreMenu.hidden;
      moreMenu.hidden = !opening;
      moreBtn.setAttribute("aria-expanded", String(opening));
    });

    moreMenu.querySelectorAll<HTMLElement>("[data-drawer]").forEach(item => {
      item.addEventListener("click", () => {
        closeMoreMenu();
        openDrawer(item.dataset.drawer!);
      });
    });

    document.addEventListener("click", closeMoreMenu);
  }


  // ── Mobile time detail popup ────────────────────────────────────────────
  const timePopup = document.getElementById("time-popup") as HTMLElement | null;
  const timePopupOverlay = document.getElementById("time-popup-overlay") as HTMLElement | null;
  const timePopupText = document.getElementById("time-popup-text") as HTMLElement | null;

  function openTimePopup(text: string) {
    if (!timePopup || !timePopupOverlay || !timePopupText) return;
    timePopupText.textContent = text;
    timePopup.hidden = false;
    timePopupOverlay.hidden = false;
  }

  function closeTimePopup() {
    if (timePopup) timePopup.hidden = true;
    if (timePopupOverlay) timePopupOverlay.hidden = true;
  }

  document.getElementById("time-popup-close")?.addEventListener("click", closeTimePopup);
  timePopupOverlay?.addEventListener("click", closeTimePopup);

  // Vote form time labels
  document.querySelectorAll<HTMLElement>(".time-label[data-full]").forEach((el) => {
    el.addEventListener("click", () => openTimePopup(el.dataset.full!));
  });

  // Grid column headers
  document.querySelectorAll<HTMLElement>(".avail-opt-hdr[data-full]").forEach((el) => {
    el.addEventListener("click", () => openTimePopup(el.dataset.full!));
  });

  // ── Availability grid scroll hint ───────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".avail-table-outer").forEach((outer) => {
    const wrap = outer.querySelector<HTMLElement>(".avail-table-wrap");
    const btn  = outer.querySelector<HTMLElement>(".scroll-hint");
    if (!wrap || !btn) return;

    const check = () => {
      const atEnd = wrap.scrollLeft + wrap.clientWidth >= wrap.scrollWidth - 4;
      outer.classList.toggle("scroll-end", atEnd);
    };
    wrap.addEventListener("scroll", check, { passive: true });
    check();

    const scrollRight = () => wrap.scrollBy({ left: wrap.clientWidth * 0.75, behavior: "smooth" });
    btn.addEventListener("click", scrollRight);
    btn.addEventListener("touchstart", (e) => { e.preventDefault(); scrollRight(); }, { passive: false });
  });

  // ── Auto-dismiss banners ─────────────────────────────────────────────────
  function dismissBanner(el: Element) {
    (el as HTMLElement).style.maxHeight = el.getBoundingClientRect().height + "px";
    requestAnimationFrame(() => (el as HTMLElement).classList.add("dismissing"));
    el.addEventListener("transitionend", () => (el as HTMLElement).remove(), { once: true });
  }

  document.querySelectorAll(".auto-banner").forEach((banner) => {
    const timer = setTimeout(() => dismissBanner(banner), 4000);
    banner.querySelector(".banner-close")?.addEventListener("click", () => {
      clearTimeout(timer);
      dismissBanner(banner);
    });
  });

  // ── Invite form — client-side submit to avoid page reload ────────────────
  // ── Invite info popup ────────────────────────────────────────────────────
  const infoBtn = document.getElementById("invite-info-btn");
  const infoPopup = document.getElementById("invite-info-popup");
  if (infoBtn && infoPopup) {
    infoBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      infoPopup.hidden = !infoPopup.hidden;
    });
    document.addEventListener("click", () => { infoPopup.hidden = true; });
  }

  const remindSendBtn = document.getElementById("remind-send-btn") as HTMLButtonElement | null;
  if (remindSendBtn) {
    remindSendBtn.addEventListener("click", async () => {
      const resultDiv = document.getElementById("remind-result") as HTMLDivElement;
      const errorDiv = document.getElementById("remind-error") as HTMLDivElement;
      const errorMsg = document.getElementById("remind-error-msg") as HTMLElement;

      remindSendBtn.disabled = true;
      remindSendBtn.textContent = "Sending…";
      resultDiv.style.display = "none";
      errorDiv.style.display = "none";

      const fd = new FormData();
      fd.append("token", remindSendBtn.dataset.pollToken!);

      const { data, error } = await actions.remindNonResponders(fd);

      remindSendBtn.disabled = false;
      remindSendBtn.textContent = "Send reminders";

      if (error) {
        errorMsg.textContent = error.message ?? "Unknown error.";
        errorDiv.style.display = "block";
      } else if (data) {
        resultDiv.textContent = `Reminders sent to ${data.sent} ${data.sent === 1 ? "person" : "people"}.`;
        resultDiv.style.display = "block";
        remindSendBtn.style.display = "none";
      }
    });
  }

  const bulkInviteForm = document.getElementById("bulk-invite-form") as HTMLFormElement | null;
  if (bulkInviteForm) {
    bulkInviteForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const btn = document.getElementById("bulk-invite-btn") as HTMLButtonElement;
      const resultDiv = document.getElementById("bulk-invite-result") as HTMLDivElement;
      const errorDiv = document.getElementById("bulk-invite-error") as HTMLDivElement;
      const errorMsg = document.getElementById("bulk-invite-error-msg") as HTMLElement;

      btn.disabled = true;
      btn.textContent = "Sending…";
      resultDiv.style.display = "none";
      errorDiv.style.display = "none";

      const fd = new FormData();
      fd.append("token", bulkInviteForm.dataset.pollToken!);
      fd.append("emails", (document.getElementById("bulk-emails") as HTMLTextAreaElement).value);

      const { data, error } = await actions.bulkInvite(fd);

      btn.disabled = false;
      btn.textContent = "Send invites";

      if (error) {
        errorMsg.textContent = error.message ?? "Unknown error.";
        errorDiv.style.display = "block";
      } else if (data) {
        const parts = [`Invites sent to ${data.sent} ${data.sent === 1 ? "person" : "people"}.`];
        if (data.skipped > 0) parts.push(`${data.skipped} already invited or skipped.`);
        resultDiv.textContent = parts.join(" ");
        resultDiv.style.display = "block";
        (document.getElementById("bulk-emails") as HTMLTextAreaElement).value = "";
      }
    });
  }

  // vote state: optionId (string) → availability (0|1|2|-1 = unset)
  const state: Record<string, number> = {};

  // Initialise from server-rendered data attributes
  document.querySelectorAll<HTMLElement>(".time-row").forEach((row) => {
    const id = row.dataset.optionId!;
    const init = parseInt(row.dataset.init ?? "-1", 10);
    state[id] = init >= 0 ? init : -1;

    // Highlight the pre-existing vote segment
    if (init >= 0) {
      row.querySelector<HTMLButtonElement>(`.vibe-seg[data-vibe="${init}"]`)?.classList.add("active");
      applyBullet(row, init);
    }

    // Wire up pill segments
    row.querySelectorAll<HTMLButtonElement>(".vibe-seg").forEach((btn) => {
      btn.addEventListener("click", () => {
        const vibe = parseInt(btn.dataset.vibe!, 10);
        state[id] = vibe;
        row.querySelectorAll(".vibe-seg").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyBullet(row, vibe);
      });
    });
  });

  function applyBullet(row: HTMLElement, vibe: number) {
    const bullet = row.querySelector<HTMLElement>("[data-bullet]");
    if (!bullet) return;
    if (vibe === 1) bullet.style.background = "var(--yes)";
    else if (vibe === 2) bullet.style.background = "var(--maybe)";
    else if (vibe === 0) bullet.style.background = "var(--red)";
    else bullet.style.background = "var(--bullet)";  // unset
  }

  // ── Confirm Dates — disable submit when no checkbox is checked ──────────────
  const finalizeSubmitBtn = document.getElementById("finalize-submit-btn") as HTMLButtonElement | null;
  if (finalizeSubmitBtn) {
    const checkboxes = document.querySelectorAll<HTMLInputElement>("input[name='optionIds']");
    const syncBtn = () => {
      const anyChecked = Array.from(checkboxes).some(c => c.checked);
      finalizeSubmitBtn.disabled = !anyChecked;
    };
    checkboxes.forEach(c => c.addEventListener("change", syncBtn));
    syncBtn();
  }

  document.getElementById("vote-form")?.addEventListener("submit", (e) => {
    const allIds = Array.from(document.querySelectorAll<HTMLElement>(".time-row"))
      .map((r) => parseInt(r.dataset.optionId!, 10));

    // Only submit slots where the user made an explicit selection
    const voteData = allIds
      .filter(id => state[String(id)] >= 0)
      .map(id => ({ optionId: id, availability: state[String(id)] }));

    if (voteData.length === 0) {
      e.preventDefault();
      alert("Please select your availability for at least one time slot.");
      return;
    }

    (document.getElementById("vote-data") as HTMLInputElement).value = JSON.stringify(voteData);
  });
</script>

